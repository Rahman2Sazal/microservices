{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/virtual-facility/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/virtual-facility/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/virtual-facility",
  "projects": {
    "mahfuz": {
      "type": "application",
      "root": "apps/mahfuz",
      "entryFile": "main",
      "sourceRoot": "apps/mahfuz/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mahfuz/tsconfig.app.json"
      }
    },
    "virtual-facility": {
      "type": "application",
      "root": "apps/virtual-facility",
      "entryFile": "main",
      "sourceRoot": "apps/virtual-facility/src",
      "compilerOptions": {
        "tsConfigPath": "apps/virtual-facility/tsconfig.app.json"
      }
    },
    "workflows": {
      "type": "library",
      "root": "libs/workflows",
      "entryFile": "index",
      "sourceRoot": "libs/workflows/src",
      "compilerOptions": {
        "tsConfigPath": "libs/workflows/tsconfig.lib.json"
      }
    },
    "workflows-classifier": {
      "type": "application",
      "root": "apps/workflows-classifier",
      "entryFile": "main",
      "sourceRoot": "apps/workflows-classifier/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workflows-classifier/tsconfig.app.json"
      }
    },
    "workflows-notification": {
      "type": "application",
      "root": "apps/workflows-notification",
      "entryFile": "main",
      "sourceRoot": "apps/workflows-notification/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workflows-notification/tsconfig.app.json"
      }
    },
    "workflows-service": {
      "type": "application",
      "root": "apps/workflows-service",
      "entryFile": "main",
      "sourceRoot": "apps/workflows-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workflows-service/tsconfig.app.json"
      }
    }
  }
}